{
    "name": "vencord-message-purger",
    "version": "1.0.0",
    "description": "Vencord plugin that deletes your own messages in a private chat or a server text channel — filtered, paced, exportable first.",
    "license": "GPL-3.0-or-later",
    "author": "HajiLight",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "link": "node scripts/dev.mjs",
        "build": "node scripts/dev.mjs --build",
        "typecheck": "node scripts/typecheck.mjs",
        "test": "vitest run",
        "test:watch": "vitest",
        "check": "node scripts/typecheck.mjs && vitest run"
    },
    "devDependencies": {
        "@types/node": "^26.6.6",
        "@vitest/coverage-v8": "5.1.1",
        "standalone-electron-types": "^41.2.1",
        "typescript": "^7.0.2",
        "vitest": "^5.1.1"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/HajiLight/vencord-message-purger.git"
    }
}
